{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "grysync",
  "version": "0.1.0",
  "identifier": "io.github.kennerblick.grysync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "grysync",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "GUI for rsync",
    "longDescription": "grysync is a modern, fast, cross-platform graphical front end for rsync that exposes every rsync option.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["rsync"] },
      "rpm": { "depends": ["rsync"] }
    }
  }
}
